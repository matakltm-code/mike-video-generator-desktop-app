{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "composite": true,
    "outDir": "./out",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "gui/**/*.ts",
    "gui/**/*.tsx",
    "shared/**/*.ts"
  ]
}
